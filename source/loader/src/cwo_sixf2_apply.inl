// v5.1 six fighters, route A step 2: every per-fighter store of the game that must hold 6 fighters moves to a bigger copy,
// the fighter-count compares and sizes change, and three HUD writes get a 4-panel guard (shared with tests/sixf_test.cpp).
// Data: cwo_sixf2_sites.h, generated by tools/build_sixf2.py from the clean PDUWP.exe (9ba7411b) and
// tools/sixf2_manifest.py (every entry there names its game evidence). Independently authored.
#include <limits.h>
#include "cwo_sixf2_sites.h"

static const size_t SIXF2_NSTORES = sizeof(SIXF2_STORES) / sizeof(*SIXF2_STORES);
static const size_t SIXF2_NSITES = sizeof(SIXF2_SITES) / sizeof(*SIXF2_SITES);
static const size_t SIXF2_NPATCHES = sizeof(SIXF2_PATCHES) / sizeof(*SIXF2_PATCHES);
static const size_t SIXF2_NSTUBS = sizeof(SIXF2_STUBS) / sizeof(*SIXF2_STUBS);
static const size_t SIXF2_NSEGS = sizeof(SIXF2_SEGS) / sizeof(*SIXF2_SEGS);

// the new address of an old address inside a store (or 0 when it is in none); `block` = the stores' block
static ULONG_PTR sixf2_map(ULONG_PTR base, ULONG_PTR block, ULONG_PTR rva) {
    for (size_t i = 0; i < SIXF2_NSEGS; i++) {
        const Sixf2Seg &g = SIXF2_SEGS[i];
        const Sixf2Store &s = SIXF2_STORES[g.store];
        if (rva >= s.rva + g.old_off && rva < s.rva + g.old_off + g.len)
            return block + s.at + g.new_off + (rva - s.rva - g.old_off);
    }
    (void)base;
    return 0;
}

// all-or-nothing: check every byte that will change, check reach, copy the stores, then write
typedef ULONG_PTR (*Sixf2Fn)(const char *name);            // the loader functions the call stubs reach, by name
static size_t g_sixf2_room = 0x1000;                       // bytes free at `stubs`
static bool sixf2_apply(ULONG_PTR base, ULONG_PTR block, ULONG_PTR stubs, Sixf2Fn fn, char *why, size_t nwhy) {
    for (size_t i = 0; i < SIXF2_NSITES; i++) {
        const Sixf2Site &s = SIXF2_SITES[i];
        if (memcmp((const void *)(base + s.rva), s.b, s.len)) { sprintf_s(why, nwhy, "site %zu at +0x%x differs", i, s.rva); return false; }
    }
    for (size_t i = 0; i < SIXF2_NPATCHES; i++) {
        const Sixf2Patch &p = SIXF2_PATCHES[i];
        if (memcmp((const void *)(base + p.rva), p.old, p.len)) { sprintf_s(why, nwhy, "patch %zu at +0x%x differs", i, p.rva); return false; }
    }
    for (size_t i = 0; i < SIXF2_NSTUBS; i++) {
        const Sixf2Stub &t = SIXF2_STUBS[i];
        if (t.len > sizeof(t.site)) { sprintf_s(why, nwhy, "stub %s too long", t.name); return false; }
        if (memcmp((const void *)(base + t.rva), t.site, t.len)) { sprintf_s(why, nwhy, "stub %s at +0x%x differs", t.name, t.rva); return false; }
    }
    static_assert(sizeof(SIXF2_STUBS) / sizeof(*SIXF2_STUBS) <= 64, "more detours than stub_at holds");
    ULONG_PTR stub_at[64] = {0};                               // v5.7: 40 detours (the projectile hit mask added 32)
    ULONG_PTR sp = stubs;
    for (size_t i = 0; i < SIXF2_NSTUBS; i++) { stub_at[i] = sp; sp += (SIXF2_STUBS[i].code_len + 15) & ~15u; }
    if (sp - stubs > g_sixf2_room) { sprintf_s(why, nwhy, "stubs do not fit (%zu bytes)", (size_t)(sp - stubs)); return false; }
    for (size_t i = 0; i < SIXF2_NSITES; i++) {
        const Sixf2Site &s = SIXF2_SITES[i];
        long long tgt = (long long)(block + SIXF2_STORES[s.store].at + s.newoff);
        long long d = s.mode == 0 ? tgt - (long long)(base + s.rva + s.len) : tgt - (long long)base;
        if (d < INT_MIN || d > INT_MAX || (s.mode == 1 && d < 0)) { sprintf_s(why, nwhy, "site %zu out of reach", i); return false; }
    }
    for (size_t i = 0; i < SIXF2_NSTUBS; i++) {
        long long d = (long long)stub_at[i] - (long long)(base + SIXF2_STUBS[i].rva + 5);
        if (d < INT_MIN || d > INT_MAX) { sprintf_s(why, nwhy, "stub %zu out of reach", i); return false; }
        if (SIXF2_STUBS[i].fn && (!fn || !fn(SIXF2_STUBS[i].fn))) { sprintf_s(why, nwhy, "no function %s", SIXF2_STUBS[i].fn); return false; }
    }
    for (size_t i = 0; i < SIXF2_NSEGS; i++) {                 // the stores keep what they held
        const Sixf2Seg &g = SIXF2_SEGS[i];
        const Sixf2Store &s = SIXF2_STORES[g.store];
        memcpy((void *)(block + s.at + g.new_off), (const void *)(base + s.rva + g.old_off), g.len);
    }
    for (size_t i = 0; i < SIXF2_NSITES; i++) {
        const Sixf2Site &s = SIXF2_SITES[i];
        long long tgt = (long long)(block + SIXF2_STORES[s.store].at + s.newoff);
        int d = (int)(s.mode == 0 ? tgt - (long long)(base + s.rva + s.len) : tgt - (long long)base);
        memcpy((void *)(base + s.rva + s.dispoff), &d, 4);
    }
    for (size_t i = 0; i < SIXF2_NPATCHES; i++) {
        const Sixf2Patch &p = SIXF2_PATCHES[i];
        if (p.size == 1) *(unsigned char *)(base + p.rva + p.at) = (unsigned char)p.newv;
        else memcpy((void *)(base + p.rva + p.at), &p.newv, 4);
    }
    for (size_t i = 0; i < SIXF2_NSTUBS; i++) {
        const Sixf2Stub &t = SIXF2_STUBS[i];
        memcpy((void *)stub_at[i], t.code, t.code_len);
        ULONG_PTR back = base + t.fix_rva;
        memcpy((void *)(stub_at[i] + t.fix_at), &back, 8);
        if (t.fn) { ULONG_PTR f = fn(t.fn); memcpy((void *)(stub_at[i] + t.fn_at), &f, 8); }
        if (t.jmp_at >= 0) {                                   // {JMP} an exe address; v5.188.26 {ADDR} a moved store's new place
            ULONG_PTR m = sixf2_map(base, block, t.jmp_rva), j = m ? m : base + t.jmp_rva;
            memcpy((void *)(stub_at[i] + t.jmp_at), &j, 8);
        }
        unsigned char j[sizeof(t.site)];                       // v5.7: a detour may replace up to 40 bytes
        memset(j, 0x90, sizeof(j));
        j[0] = 0xE9;
        int rel = (int)((long long)stub_at[i] - (long long)(base + t.rva + 5));
        memcpy(j + 1, &rel, 4);
        memcpy((void *)(base + t.rva), j, t.len);
    }
    return true;
}
